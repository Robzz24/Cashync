# Base de datos PostgreSQL (Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/cashync?sslmode=require"

# Secret para JWT (mínimo 32 caracteres aleatorios)
AUTH_SECRET="tu-secret-aleatorio-de-al-menos-32-caracteres"

# URL de la app en producción
NEXTAUTH_URL="https://tu-dominio.vercel.app"
